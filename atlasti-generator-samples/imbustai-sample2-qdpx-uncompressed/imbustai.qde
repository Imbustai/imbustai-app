ico,…"><Coding creatingUser="3259B7CC-0F60-4FE3-95C7-C813D9F61B56" creationDateTime="2026-05-06T12:42:36Z" guid="FB168BE3-5A29-44C5-8020-0392532748F1"><CodeRef targetGUID="E550314D-2F95-49DD-84F9-3899FE609505"></CodeRef></Coding><Coding creatingUser="3259B7CC-0F60-4FE3-95C7-C813D9F61B56" creationDateTime="2026-05-06T12:42:43Z" guid="8FE86D41-AF18-455B-BF9D-52F8FFAD8AC9"><CodeRef targetGUID="18B1608D-0083-42FD-9C50-492D55AE06C6"></CodeRef></Coding></PlainTextSelection><PlainTextSelection startPosition="11249" modifyingUser="3259B7CC-0F60-4FE3-95C7-C813D9F61B56" modifiedDateTime="2026-04-30T13:48:46Z" creatingUser="3259B7CC-0F60-4FE3-95C7-C813D9F61B56" creationDateTime="2026-04-30T13:48:46Z" endPosition="11903" guid="E824670D-D7E8-469B-8324-ABF15A2C9D60" name="Ciao Apaya, è una situazione molto molto complicata, di certo non vorrei essere al tuo posto. Penso…"><Coding creatingUser="3259B7CC-0F60-4FE3-95C7-C813D9F61B56" creationDateTime="2026-04-30T13:48:46Z" guid="151B6845-C34E-48D7-9796-2639F457AFA5"><CodeRef targetGUID="63106DDC-3E7E-4578-9CE9-28ED297E555F"></CodeRef></Coding></PlainTextSelection><PlainTextSelection startPosition="9169" modifyingUser="3259B7CC-0F60-4FE3-95C7-C813D9F61B56" modifiedDateTime="2026-05-07T14:48:18Z" creatingUser="3259B7CC-0F60-4FE3-95C7-C813D9F61B56" creationDateTime="2026-05-07T14:48:18Z" endPosition="9379" guid="52D92AC9-C9DC-4171-A723-EF42EDE6B0E9" name="hai ragione, qui ad Arvuna è molto più semplice avere un animale. Se devo assentarmi, c'è sempre qua…"><Coding creatingUser="3259B7CC-0F60-4FE3-95C7-C813D9F61B56" creationDateTime="2026-05-07T14:48:18Z" guid="8A6F9AC4-85F7-44AC-8413-3FBCF72A8129"><CodeRef targetGUID="642517E9-E152-4E14-AA3C-BA2F62C28420"></CodeRef></Coding></PlainTextSelection><PlainTextSelection startPosition="10778" modifyingUser="3259B7CC-0F60-4FE3-95C7-C813D9F61B56" modifiedDateTime="2026-05-07T14:58:43Z" creatingUser="3259B7CC-0F60-4FE3-95C7-C813D9F61B56" creationDateTime="2026-05-07T14:58:43Z" endPosition="10940