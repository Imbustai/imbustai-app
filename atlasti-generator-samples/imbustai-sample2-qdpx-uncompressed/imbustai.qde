a. Le mie ma…"><Coding creatingUser="3259B7CC-0F60-4FE3-95C7-C813D9F61B56" creationDateTime="2026-05-14T08:55:56Z" guid="CE0D374E-278C-4AE9-8D34-3DB53CA6DDB2"><CodeRef targetGUID="C6C31265-093C-43D8-8819-37B10EFF75B6"></CodeRef></Coding><Coding creatingUser="3259B7CC-0F60-4FE3-95C7-C813D9F61B56" creationDateTime="2026-05-14T08:56:16Z" guid="E649B8D3-E94F-4812-814F-73052DD515D0"><CodeRef targetGUID="D6A968EF-5792-4F4D-8456-82E37C3E4FF9"></CodeRef></Coding><Coding creatingUser="3259B7CC-0F60-4FE3-95C7-C813D9F61B56" creationDateTime="2026-05-14T08:55:37Z" guid="67F4926A-BA6B-46E3-AB61-CA7878DBAD27"><CodeRef targetGUID="2DD4A5DE-1BF7-41C6-98A1-3C9B027DAA12"></CodeRef></Coding><Coding creatingUser="3259B7CC-0F60-4FE3-95C7-C813D9F61B56" creationDateTime="2026-05-14T08:55:44Z" guid="00FF8787-28C6-4543-B804-A6B6EFB04151"><CodeRef targetGUID="42D6DE16-ECDD-4F01-9F3A-1B44FEB414B5"></CodeRef></Coding></PlainTextSelection><PlainTextSelection startPosition="11146" modifyingUser="3259B7CC-0F60-4FE3-95C7-C813D9F61B56" modifiedDateTime="2026-05-07T15:00:46Z" creatingUser="3259B7CC-0F60-4FE3-95C7-C813D9F61B56" creationDateTime="2026-05-07T15:00:46Z" endPosition="11175" guid="2C224319-9C79-497B-952D-44D94D40FDB4" name="Tu cosa faresti al mio posto?"><Coding creatingUser="3259B7CC-0F60-4FE3-95C7-C813D9F61B56" creationDateTime="2026-05-07T15:00:46Z" guid="BC2F98C3-92A8-4CCD-B584-0BA0D7218027"><CodeRef targetGUID="C6C31265-093C-43D8-8819-37B10EFF75B6"></CodeRef></Coding></PlainTextSelection><PlainTextSelection startPosition="3293" modifyingUser="3259B7CC-0F60-4FE3-95C7-C813D9F61B56" modifiedDateTime="2026-05-06T12:45:08Z" creatingUser="3259B7CC-0F60-4FE3-95C7-C813D9F61B56" creationDateTime="2026-05-06T12:45:08Z" endPosition="3359" guid="D869499F-B20D-4DAD-9DBF-30F3FCEB2DA6" name="e poi è il tuo vero nome, quello che avevi quando eravamo bambini."><Coding creatingUser="3259B7CC-0F60-4FE3-95C7-C813D9F61B56" creationDateTime="2026-05-06T12:45:08Z" guid="7DED3DDD-D745-4720-A9A5-00674F78846F