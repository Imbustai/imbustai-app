# Supabase (website project — separate from tryout)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL (no trailing slash) — auth redirects & Stripe return URLs
NEXT_PUBLIC_SITE_URL=http://localhost:4200

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional
# NEXT_PUBLIC_SIGNUP_URL=/register

# Story engine AI provider (server-side only).
# STORY_ENGINE_PROVIDER selects the provider: claude (default) | openai | deepseek.
# Only 'claude' is implemented today; openai/deepseek are a ready seam (the
# AiProvider interface + ai_model_pricing rows already exist).
STORY_ENGINE_PROVIDER=claude
# Optional model override (defaults to claude-opus-4-8 for Claude).
STORY_ENGINE_MODEL=

# Claude API (story engine reply generation — server-side only)
ANTHROPIC_API_KEY=

# Future providers (used once OpenAiProvider / DeepSeekProvider land):
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
