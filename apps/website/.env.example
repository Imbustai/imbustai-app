# Supabase (website project — separate from tryout)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL (no trailing slash) — auth redirects & Stripe return URLs
NEXT_PUBLIC_SITE_URL=http://localhost:4200

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional
# NEXT_PUBLIC_SIGNUP_URL=/register

# AI providers (server-side only). Models are chosen per Game by its model
# profile (platform default → Story default → override at start); the price
# table (Admin → Settings) says which provider serves each model. A key is
# only needed for a provider some profile actually uses.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
